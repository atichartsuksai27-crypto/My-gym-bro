<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="Gymbro Daily β"
        android:supportsRtl="true"
        android:theme="@style/Theme.GymbroDaily">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- รับ redirect กลับจาก Supabase Google OAuth — ต้องเพิ่ม
                 gymbrodailybeta://auth-callback ใน Supabase Dashboard >
                 Authentication > URL Configuration > Redirect URLs -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gymbrodailybeta" android:host="auth-callback" />
            </intent-filter>
        </activity>
    </application>
</manifest>
